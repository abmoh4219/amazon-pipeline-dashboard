# ==============================
# Database Configuration
# ==============================

# For development (local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=amazon_dashboard

# For production (Render will provide these)
# DATABASE_URL=postgresql://user:password@host:port/database_name

# ==============================
# Application Settings
# ==============================
NODE_ENV=development
PORT=3000

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# ==============================
# Third-Party API Keys
# ==============================
# ScrapingBee API key (for web scraping)
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here

# ==============================
# Performance & Security
# ==============================
# Node.js memory limit (in MB)
NODE_OPTIONS=--max-old-space-size=1024

# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # 100 requests per window

# ==============================
# Logging
# ==============================
# Log level: error, warn, info, debug
LOG_LEVEL=debug

# ==============================
# Session & Security
# ==============================
# Generate a strong secret: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# ==============================
# Caching (optional)
# ==============================
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600  # 1 hour
